{
  "description": "brain-core: tiered session bootstrap, Haiku re-anchor, warn-only edit checks, transcript archive before compaction, session log. Every hook no-ops outside a claude-second-brain-os workspace.",
  "hooks": {
    "SessionStart": [
      {"matcher": "", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_hook.py\" session-start", "timeout": 20}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_hook.py\" user-prompt-submit", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_hook.py\" post-tool-use", "timeout": 15}]}
    ],
    "PreCompact": [
      {"matcher": "", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_hook.py\" pre-compact", "timeout": 20}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/brain_hook.py\" stop", "timeout": 10}]}
    ]
  }
}
