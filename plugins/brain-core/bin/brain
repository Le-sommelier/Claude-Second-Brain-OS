#!/usr/bin/env python3
"""brain — the claude-second-brain-os core CLI (shipped by brain-core; on PATH through the plugin's bin/).

    brain root
    brain doctor [--quick]
    brain pending --flag wiki_processed [--source-type T] [--max-age-days N]
    brain flag --set wiki_processed=true (--file <rel> | --files-from <payload.json>)
    brain kb build|index|query|show|attention|trust|append|propose|confirm ...
    brain new project <slug> | topic <slug> | person <first-last>
    brain run plan [--today D] | run finalise --returns <payload.json>

Other modules call core only through this command, never through a plugin file path.
Contract: docs/module-contract.md §5b.
"""
from __future__ import annotations

import sys
from pathlib import Path

PLUGIN = Path(__file__).resolve().parents[1]
# Vendored lib (plugins/brain-core/lib) in an installed plugin; the repo's /lib during development.
for candidate in (PLUGIN / "lib", PLUGIN.parents[1] / "lib"):
    if (candidate / "brainos" / "workspace.py").is_file():
        sys.path.insert(0, str(candidate))
        break
sys.path.insert(0, str(PLUGIN / "scripts"))

from braincore.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
